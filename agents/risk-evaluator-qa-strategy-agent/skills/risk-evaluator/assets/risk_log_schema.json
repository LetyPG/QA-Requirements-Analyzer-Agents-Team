{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Risk Log JSON Lines Schema",
  "description": "Schema for each line in the risk.jsonl append-only ADR log",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "YYYY-MM-DD HH:MM:SS"
    },
    "rf_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "complexity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "risk_score": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "probability": {
      "type": "string",
      "enum": ["High", "Medium-High", "Medium", "Medium-Low", "Low"]
    },
    "owasp_id": {
      "type": "string",
      "description": "Optional OWASP Top 10 Application Risk ID"
    },
    "justification": {
      "type": "string"
    }
  },
  "required": [
    "timestamp",
    "rf_id",
    "tags",
    "impact",
    "complexity",
    "risk_score",
    "severity",
    "probability",
    "justification"
  ]
}
